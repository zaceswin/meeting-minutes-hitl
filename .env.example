# Copy to .env and `export $(cat .env | xargs)` (or use direnv). Never commit .env.
HF_TOKEN=hf_xxx                 # Hugging Face token; accept pyannote model terms on huggingface.co first
ANTHROPIC_API_KEY=sk-ant-xxx    # only for EXTRACT_BACKEND=anthropic
EXTRACT_BACKEND=anthropic       # or: ollama (fully local, nothing leaves the machine)
MINUTES_MODEL=claude-sonnet-5-5
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
